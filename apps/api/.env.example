# The backend automatically uses Gemini when this key is present.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GENERATION_PROVIDER=auto

HOST=0.0.0.0
PORT=4000
DATA_DIR=../../.data
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional shared bearer token for a private deployment.
API_AUTH_TOKEN=
