# Web service runtime
NODE_ENV=production
API_INTERNAL_URL=http://api:4000
NEXT_PUBLIC_DEV_ACCESS_MODE=true
NEXT_PUBLIC_SKIP_TEMPLATES_FETCH=true
NEXT_PUBLIC_DEPLOY_PLACEHOLDER_MODE=true
NEXT_PUBLIC_CHAIN_BASE_ENABLED=false

# The browser can use the same-origin API proxy. Set these only if the API
# service is also publicly exposed under its own domain.
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_SOCKET_URL=

# API service runtime. Store GEMINI_API_KEY as a Zerops secret, not in git.
HOST=0.0.0.0
PORT=4000
DATA_DIR=./data
GENERATION_PROVIDER=auto
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
CORS_ORIGINS=https://blackin.club,https://web-2ad8-3000.prg1.zerops.app

# Optional production integrations
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_MAINNET_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_ONCHAINKIT_API_KEY=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
